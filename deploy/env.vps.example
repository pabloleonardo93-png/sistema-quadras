# Copie este arquivo para .env na VPS e preencha os valores reais somente no servidor.
# Nao commite o .env real.

NODE_ENV=production
TRUST_PROXY=1
FRONTEND_BIND=127.0.0.1:8080

POSTGRES_DB=<nome_do_banco>
POSTGRES_USER=<usuario_do_banco>
POSTGRES_PASSWORD=<senha_do_banco>

JWT_SECRET=<segredo_jwt_longo>
JWT_EXPIRES_IN=1d
ADMIN_SEED_NAME=Administrador Local
ADMIN_SEED_EMAIL=<email_admin>
ADMIN_SEED_PASSWORD=<senha_admin>

APP_PUBLIC_URL=https://<dominio>:<porta_https>
API_PUBLIC_URL=https://<dominio>:<porta_https>
CORS_ORIGIN=https://<dominio>:<porta_https>

UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=5242880

MERCADO_PAGO_ACCESS_TOKEN=<token_real_mercado_pago>
MERCADO_PAGO_WEBHOOK_URL=https://<dominio>:<porta_https>/api/webhooks/mercadopago
MERCADO_PAGO_WEBHOOK_SECRET=<segredo_webhook_mercado_pago>

RESEND_API_KEY=<chave_resend_ou_vazio>
RESEND_FROM_EMAIL=<remetente_resend_ou_vazio>
EMAIL_FROM=<remetente_email_ou_vazio>
RESEND_TEMPLATE_VERIFICACAO_ID=<template_resend_ou_vazio>
EMAIL_VERIFICATION_PROVIDER=resend
EMAIL_VERIFICATION_JWT_SECRET=<segredo_email_ou_vazio_para_usar_jwt_secret>
CODIGO_VERIFICACAO_EXPIRACAO_MINUTOS=10

WUD_WATCHER_LOCAL_CRON=*/2 * * * *
WUD_TRIGGER_DOCKER_LOCAL_AUTO=true
WUD_TRIGGER_DOCKER_LOCAL_PRUNE=true
