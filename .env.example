# Aplicação
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:8080
APP_PUBLIC_URL=http://localhost:8080
API_PUBLIC_URL=http://localhost:8080
TRUST_PROXY_HOPS=2

# PostgreSQL usado pelo Docker Compose
POSTGRES_DB=sistema_quadras
POSTGRES_USER=sistema_quadras
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432

# Conexão usada ao executar o backend fora do Docker
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sistema_quadras
DB_USER=sistema_quadras
DB_PASSWORD=troque-esta-senha
DB_SSL=false
DB_LOGGING=false

# Autenticação administrativa
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=1d
ADMIN_SEED_NAME=Administrador Local
ADMIN_SEED_EMAIL=admin@exemplo.com
ADMIN_SEED_PASSWORD=troque-esta-senha

# Uploads
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=5242880

# Mercado Pago — deixe vazio enquanto a integração não estiver em uso
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
RESERVA_PAGAMENTO_TEMPO_MINUTOS=10
RESERVA_EXPIRACAO_INTERVALO_MS=60000

# E-mail — use mock no desenvolvimento local
EMAIL_VERIFICATION_PROVIDER=mock
RESEND_API_KEY=
RESEND_FROM_EMAIL=
EMAIL_FROM=
RESEND_TEMPLATE_VERIFICACAO_ID=

# Verificação de e-mail e limites de segurança
EMAIL_VERIFICATION_JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
EMAIL_VERIFICATION_COOKIE_SECURE=false
EMAIL_VERIFICATION_COOKIE_NAME=email_verification_token
CODIGO_VERIFICACAO_EXPIRACAO_MINUTOS=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_RATE_WINDOW_MINUTES=60
EMAIL_VERIFICATION_MAX_SENDS_PER_EMAIL=5
EMAIL_VERIFICATION_MAX_SENDS_PER_IP=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_MAX_CONFIRM_ATTEMPTS_PER_WINDOW=10
EMAIL_VERIFICATION_CONFIRM_RATE_WINDOW_MINUTES=60

# Limites dos fluxos de cliente
CLIENTE_DADOS_RATE_WINDOW_MINUTES=60
CLIENTE_DADOS_MAX_ATTEMPTS_PER_EMAIL=20
RESERVA_CREATE_RATE_WINDOW_MINUTES=60
RESERVA_CREATE_MAX_ATTEMPTS_PER_WINDOW=12
PAGAMENTO_CREATE_RATE_WINDOW_MINUTES=60
PAGAMENTO_CREATE_MAX_ATTEMPTS_PER_WINDOW=12

# Frontend e serviços auxiliares
VITE_API_URL=/api
FRONTEND_BIND=127.0.0.1:8080
WUD_BIND=127.0.0.1:3000
WUD_WATCHER_LOCAL_CRON=*/2 * * * *
WUD_TRIGGER_DOCKER_LOCAL_PRUNE=true
